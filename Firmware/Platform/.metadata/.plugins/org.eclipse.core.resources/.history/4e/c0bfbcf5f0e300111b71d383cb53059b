/* Cho mot co SR1 bat len. 0 = OK, -1 = NACK, -2 = timeout */
static int I2C1_WaitFlag(uint32_t (*isFlag)(I2C_TypeDef *))
{
  uint32_t t = I2C_TIMEOUT;
  while (!isFlag(I2C1))
  {
    if (LL_I2C_IsActiveFlag_AF(I2C1)) return -1;
    if (--t == 0)                     return -2;
  }
  return 0;
}

/* Reset mem I2C1 khi bus bi ket roi khoi tao lai */
static void I2C1_Recover(void)
{
  LL_I2C_EnableReset(I2C1);
  LL_I2C_DisableReset(I2C1);
  MX_I2C1_Init();
  LL_I2C_Enable(I2C1);
}

/* Ghi len byte toi slave dia chi 7-bit. Tra ve 0 neu thanh cong */
static int I2C1_Write(uint8_t addr7, const uint8_t *data, uint16_t len)
{
  uint32_t t = I2C_TIMEOUT;

  /* Cho bus ranh */
  while (LL_I2C_IsActiveFlag_BUSY(I2C1))
  {
    if (--t == 0) { I2C1_Recover(); return -3; }
  }

  /* START */
  LL_I2C_GenerateStartCondition(I2C1);
  if (I2C1_WaitFlag(LL_I2C_IsActiveFlag_SB)) goto error;

  /* Dia chi + bit W */
  LL_I2C_TransmitData8(I2C1, (uint8_t)(addr7 << 1));
  if (I2C1_WaitFlag(LL_I2C_IsActiveFlag_ADDR)) goto error;
  LL_I2C_ClearFlag_ADDR(I2C1);

  /* Du lieu */
  for (uint16_t i = 0; i < len; i++)
  {
    if (I2C1_WaitFlag(LL_I2C_IsActiveFlag_TXE)) goto error;
    LL_I2C_TransmitData8(I2C1, data[i]);
  }
  if (I2C1_WaitFlag(LL_I2C_IsActiveFlag_BTF)) goto error;

  /* STOP */
  LL_I2C_GenerateStopCondition(I2C1);
  return 0;

error:
  LL_I2C_ClearFlag_AF(I2C1);
  LL_I2C_GenerateStopCondition(I2C1);
  return -1;
}

