/*
 * stm32_spi_io.c
 *
 * STM32F103C8 (medium-density: SPI1 + SPI2, unlike the low-density
 * STM32F103C6 this project originally targeted, which only has SPI1)
 * backend for the spi_io.h abstraction. Talks to the peripheral
 * directly through CMSIS registers, the same low-level style as the
 * samv71/ reference implementation, so no extra HAL module needs to be
 * vendored in just for this driver.
 *
 * Pin mapping (no remap - AFIO is left at its default):
 *   SPI1: SCK = PA5, MISO = PA6, MOSI = PA7 (see
 *     1.Document/docs/hardware/connections.md - this is the bus RC522 is
 *     wired to).
 *   SPI2: SCK = PB13, MISO = PB14, MOSI = PB15. Not yet used by any
 *     device in this board's design (see connections.md) - added here
 *     because the C8 part exposes it, for whichever future device ends
 *     up on it.
 * Neither bus's NSS/chip-select pin (PA4 for SPI1, PB12 for SPI2) is
 * driven by this file - both are left in software NSS mode (SSM=1/SSI=1)
 * and the caller (e.g. the RC522 driver) toggles its own CS GPIO, since
 * one SPI bus here is shared by any number of devices.
 *
 * None of the functions below touch me->lock - see the locking-policy
 * note in spi_io.h. They assume the application/task layer already
 * called spi_io_lock() before invoking them.
 */

#include <stddef.h>
#include <stdbool.h>
#include <stdint.h>

#include "os.h"
#include "spi_io.h"
#include "define.h"
#include "stm32f1xx.h"

#define SPI_TIMEOUT_MS      100U
#define SPI_MAX_BUS_NUMBER  2U   /* STM32F103C8 (medium-density): SPI1 + SPI2 */

static SPI_TypeDef *const spi_periph[SPI_MAX_BUS_NUMBER + 1U] = {
    NULL,
    SPI1,
    SPI2
};

/*==============================================================================
 * Private Functions
 *============================================================================*/

static SPI_TypeDef *spi_get_instance(uint32_t spi_port)
{
    if ((spi_port == 0U) || (spi_port > SPI_MAX_BUS_NUMBER)) {
        return NULL;
    }

    return spi_periph[spi_port];
}

static void spi_enable_clock(uint32_t spi_port)
{
    if (spi_port == 1U) {
        RCC->APB2ENR |= RCC_APB2ENR_SPI1EN;
    } else if (spi_port == 2U) {
        RCC->APB1ENR |= RCC_APB1ENR_SPI2EN; /* SPI2 is on APB1, unlike SPI1 on APB2 */
    }
}

static void spi_gpio_init(uint32_t spi_port)
{
    if (spi_port == 1U) {
        RCC->APB2ENR |= RCC_APB2ENR_IOPAEN;

        /* PA5 (SCK), PA7 (MOSI): alternate-function push-pull, 50MHz */
        GPIOA->CRL &= ~(GPIO_CRL_MODE5_Msk | GPIO_CRL_CNF5_Msk |
                        GPIO_CRL_MODE7_Msk | GPIO_CRL_CNF7_Msk);
        GPIOA->CRL |= (GPIO_CRL_MODE5_Msk | GPIO_CRL_CNF5_1) |
                      (GPIO_CRL_MODE7_Msk | GPIO_CRL_CNF7_1);

        /* PA6 (MISO): input floating */
        GPIOA->CRL &= ~(GPIO_CRL_MODE6_Msk | GPIO_CRL_CNF6_Msk);
        GPIOA->CRL |= GPIO_CRL_CNF6_0;
    } else if (spi_port == 2U) {
        RCC->APB2ENR |= RCC_APB2ENR_IOPBEN; /* GPIO clocks are always on APB2 */

        /* PB13 (SCK), PB15 (MOSI): alternate-function push-pull, 50MHz */
        GPIOB->CRH &= ~(GPIO_CRH_MODE13_Msk | GPIO_CRH_CNF13_Msk |
                        GPIO_CRH_MODE15_Msk | GPIO_CRH_CNF15_Msk);
        GPIOB->CRH |= (GPIO_CRH_MODE13_Msk | GPIO_CRH_CNF13_1) |
                      (GPIO_CRH_MODE15_Msk | GPIO_CRH_CNF15_1);

        /* PB14 (MISO): input floating */
        GPIOB->CRH &= ~(GPIO_CRH_MODE14_Msk | GPIO_CRH_CNF14_Msk);
        GPIOB->CRH |= GPIO_CRH_CNF14_0;
    }
}

/*==============================================================================
 * Configuration
 *============================================================================*/

uint32_t spi_io_init(spi_io_t *me)
{
    uint32_t err = spi_io_lock_init(me);

    if (err != ERROR_OK) {
        return err;
    }

    SPI_TypeDef *spi = spi_get_instance(me->ui32SpiPort);

    if (spi == NULL) {
        return ERROR_INVALID_PARAM;
    }

    spi_enable_clock(me->ui32SpiPort);
    spi_gpio_init(me->ui32SpiPort);

    /* Master, software NSS (CS handled by caller), MSB first, 8-bit,
     * SPI_MODE_0, fPCLK/32 - a conservative default; override via
     * spi_io_set_mode()/spi_io_set_prescale()/spi_io_set_frame_size(). */
    spi->CR1 = SPI_CR1_MSTR | SPI_CR1_SSM | SPI_CR1_SSI | SPI_CR1_BR_2;
    spi->CR2 = 0U;
    spi->CR1 |= SPI_CR1_SPE;

    return ERROR_OK;
}

uint32_t spi_io_set_frame_size(spi_io_t *me, uint8_t bits)
{
    if (me == NULL) {
        return ERROR_INVALID_PARAM;
    }

    SPI_TypeDef *spi = spi_get_instance(me->ui32SpiPort);

    if (spi == NULL) {
        return ERROR_INVALID_PARAM;
    }

    uint32_t dff;

    switch (bits) {
        case 8:
            dff = 0U;
            break;

        case 16:
            dff = SPI_CR1_DFF_Msk;
            break;

        default:
            return ERROR_INVALID_PARAM;
    }

    /* Caller must hold the bus lock (spi_io_lock()) - see spi_io.h. */

    /* DFF may only be written while SPE=0. */
    spi->CR1 &= ~SPI_CR1_SPE_Msk;
    spi->CR1 = (spi->CR1 & ~SPI_CR1_DFF_Msk) | dff;
    spi->CR1 |= SPI_CR1_SPE_Msk;

    return ERROR_OK;
}

uint32_t spi_io_set_mode(spi_io_t *me, uint8_t spi_mode)
{
    if ((me == NULL) || (spi_mode > SPI_MODE_3)) {
        return ERROR_INVALID_PARAM;
    }

    SPI_TypeDef *spi = spi_get_instance(me->ui32SpiPort);

    if (spi == NULL) {
        return ERROR_INVALID_PARAM;
    }

    /* Caller must hold the bus lock (spi_io_lock()) - see spi_io.h. */

    /* CPOL/CPHA may only be written while SPE=0. spi_mode's bit layout
     * (SPI_CPOL=0x02, SPI_CPHA=0x01) matches CR1's CPOL(bit1)/CPHA(bit0)
     * positions exactly, so it can be ORed in directly. */
    spi->CR1 &= ~SPI_CR1_SPE_Msk;
    spi->CR1 = (spi->CR1 & ~(SPI_CR1_CPOL_Msk | SPI_CR1_CPHA_Msk)) |
               (uint32_t)spi_mode;
    spi->CR1 |= SPI_CR1_SPE_Msk;

    return ERROR_OK;
}

uint32_t spi_io_set_prescale(spi_io_t *me, uint8_t scbr)
{
    /* STM32 SPI only has a 3-bit prescaler field (BR[2:0]: /2 .. /256 in
     * powers of two), unlike SAMV71's byte-wide SCBR clock divider. For
     * this backend, scbr IS that 0-7 BR index directly. */
    if ((me == NULL) || (scbr > 7U)) {
        return ERROR_INVALID_PARAM;
    }

    SPI_TypeDef *spi = spi_get_instance(me->ui32SpiPort);

    if (spi == NULL) {
        return ERROR_INVALID_PARAM;
    }

    /* Caller must hold the bus lock (spi_io_lock()) - see spi_io.h. */

    spi->CR1 &= ~SPI_CR1_SPE_Msk;
    spi->CR1 = (spi->CR1 & ~SPI_CR1_BR_Msk) | ((uint32_t)scbr << SPI_CR1_BR_Pos);
    spi->CR1 |= SPI_CR1_SPE_Msk;

    return ERROR_OK;
}

/*==============================================================================
 * Synchronous Transfer
 *============================================================================*/

uint32_t spi_io_transfer_sync(spi_io_t *me,
                              const uint8_t *pui8TxBuff,
                              uint8_t *pui8RxBuff,
                              uint32_t ui32Length)
{
    if (me == NULL) {
        return ERROR_INVALID_PARAM;
    }

    if (ui32Length == 0U) {
        return ERROR_OK;
    }

    SPI_TypeDef *spi = spi_get_instance(me->ui32SpiPort);

    if (spi == NULL) {
        return ERROR_INVALID_PARAM;
    }

    /* No lock here by design - see the locking-policy note in spi_io.h.
     * The caller must already hold the bus (spi_io_lock()) before this,
     * e.g. for as long as it needs CS asserted across possibly more than
     * one spi_io_* call. */

    for (uint32_t i = 0U; i < ui32Length; i++) {
        /* Wait TX buffer empty */
        if (os_reg_wait_flag_blocking(&spi->SR, SPI_SR_TXE_Msk, SPI_TIMEOUT_MS) != ERROR_OK) {
            return ERROR_TIMEOUT;
        }

        uint8_t tx_data = (pui8TxBuff != NULL) ? pui8TxBuff[i] : 0xFFU;

        /* 8-bit write: matches ST's own HAL technique of casting DR to a
         * byte pointer so only one byte goes out on the wire. */
        *(volatile uint8_t *)&spi->DR = tx_data;

        /* Wait RX buffer not empty */
        if (os_reg_wait_flag_blocking(&spi->SR, SPI_SR_RXNE_Msk, SPI_TIMEOUT_MS) != ERROR_OK) {
            return ERROR_TIMEOUT;
        }

        uint32_t sr = spi->SR;

        if ((sr & (SPI_SR_OVR_Msk | SPI_SR_MODF_Msk)) != 0U) {
            (void)spi->DR;
            return ERROR_SPI;
        }

        uint8_t rx_data = *(volatile uint8_t *)&spi->DR;

        if (pui8RxBuff != NULL) {
            pui8RxBuff[i] = rx_data;
        }
    }

    /* Wait for the last byte to finish shifting out before returning, so
     * a caller that immediately drops CS doesn't truncate it. */
    while ((spi->SR & SPI_SR_BSY_Msk) != 0U) {
        /* bounded by hardware; a lock-up here means a wiring fault */
    }

    return ERROR_OK;
}

/*==============================================================================
 * Read / Write
 *============================================================================*/

uint32_t spi_io_read_sync(spi_io_t *me,
                          uint8_t *pui8RxBuff,
                          uint32_t ui32Length)
{
    if ((me == NULL) || (pui8RxBuff == NULL)) {
        return ERROR_INVALID_PARAM;
    }

    return spi_io_transfer_sync(me, NULL, pui8RxBuff, ui32Length);
}

uint32_t spi_io_write_sync(spi_io_t *me,
                           const uint8_t *pui8TxBuff,
                           uint32_t ui32Length)
{
    if ((me == NULL) || (pui8TxBuff == NULL)) {
        return ERROR_INVALID_PARAM;
    }

    return spi_io_transfer_sync(me, pui8TxBuff, NULL, ui32Length);
}

uint32_t spi_io_write_and_read_sync(spi_io_t *me,
                                    const uint8_t *pui8TxBuff, uint32_t ui32TxLength,
                                    uint8_t *pui8RxBuff, uint32_t ui32RxLength)
{
    if (me == NULL) {
        return ERROR_INVALID_PARAM;
    }

    uint32_t err = spi_io_write_sync(me, pui8TxBuff, ui32TxLength);

    if (err != ERROR_OK) {
        return err;
    }

    return spi_io_read_sync(me, pui8RxBuff, ui32RxLength);
}
