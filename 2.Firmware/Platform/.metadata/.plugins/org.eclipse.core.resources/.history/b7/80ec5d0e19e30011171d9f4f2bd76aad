uint32_t i2c_io_set_speed(i2c_io_t *me, uint32_t ui32SpeedHz)
{
    if ((me == NULL) || (ui32SpeedHz == 0U) || (ui32SpeedHz > 400000U)) {
        return ERROR_INVALID_PARAM;
    }

    I2C_TypeDef *i2c = i2c_get_instance(me->ui32I2cPort);

    if (i2c == NULL) {
        return ERROR_INVALID_PARAM;
    }

    /* Caller must hold the bus lock (i2c_io_lock()) - see i2c_io.h. */

    uint32_t pclk1_hz = i2c_get_pclk1_hz();
    uint32_t pclk1_mhz = pclk1_hz / 1000000U;

    /* FREQ/CCR/TRISE may only be written while PE=0. */
    i2c->CR1 &= ~I2C_CR1_PE_Msk;

    i2c->CR2 = (i2c->CR2 & ~I2C_CR2_FREQ_Msk) | (pclk1_mhz & I2C_CR2_FREQ_Msk);

    if (ui32SpeedHz <= 100000U) {
        /* Standard mode: Thigh = Tlow = CCR * Tpclk1, max SCL rise 1000ns */
        uint32_t ccr = pclk1_hz / (2U * ui32SpeedHz);

        if (ccr < 4U) {
            ccr = 4U;
        }

        i2c->CCR = ccr & I2C_CCR_CCR_Msk; /* FS=0 (standard), DUTY=0 */
        i2c->TRISE = (pclk1_mhz + 1U) & I2C_TRISE_TRISE_Msk;
    } else {
        /* Fast mode, Tlow/Thigh = 2 (DUTY=0), max SCL rise 300ns */
        uint32_t ccr = pclk1_hz / (3U * ui32SpeedHz);

        if (ccr < 1U) {
            ccr = 1U;
        }

        i2c->CCR = (ccr & I2C_CCR_CCR_Msk) | I2C_CCR_FS_Msk;
        i2c->TRISE = (((pclk1_mhz * 300U) / 1000U) + 1U) & I2C_TRISE_TRISE_Msk;
    }

    i2c->CR1 |= I2C_CR1_PE_Msk;
    i2c->CR1 |= I2C_CR1_ACK_Msk;

    return ERROR_OK;
}

/*==============================================================================
 * Read / Write
 *============================================================================*/

uint32_t i2c_io_write_sync(i2c_io_t *me, uint16_t ui16DevAddr,
                           const uint8_t *pui8TxBuff, uint32_t ui32Length)
{
    if ((me == NULL) || (pui8TxBuff == NULL) || (ui32Length == 0U)) {
        return ERROR_INVALID_PARAM;
    }

    I2C_TypeDef *i2c = i2c_get_instance(me->ui32I2cPort);

    if (i2c == NULL) {
        return ERROR_INVALID_PARAM;
    }

    /* Caller must hold the bus lock (i2c_io_lock()) - see i2c_io.h. */

    uint32_t err = i2c_start(i2c, ui16DevAddr, false);

    if (err == ERROR_OK) {
        err = i2c_write_bytes(i2c, pui8TxBuff, ui32Length);
    }

    /* Always generate STOP, whether or not the transfer succeeded -
     * leaving it ungenerated would hang every subsequent transaction. */
    i2c->CR1 |= I2C_CR1_STOP_Msk;

    return err;
}

uint32_t i2c_io_read_sync(i2c_io_t *me, uint16_t ui16DevAddr,
                          uint8_t *pui8RxBuff, uint32_t ui32Length)
{
    if ((me == NULL) || (pui8RxBuff == NULL) || (ui32Length == 0U)) {
        return ERROR_INVALID_PARAM;
    }

    I2C_TypeDef *i2c = i2c_get_instance(me->ui32I2cPort);

    if (i2c == NULL) {
        return ERROR_INVALID_PARAM;
    }

    /* Caller must hold the bus lock (i2c_io_lock()) - see i2c_io.h. */

    uint32_t err = i2c_start(i2c, ui16DevAddr, true);

    if (err == ERROR_OK) {
        /* i2c_read_bytes() generates STOP itself, at the point required
         * by the byte count (see RM0008) - do not also set it here. */
        err = i2c_read_bytes(i2c, pui8RxBuff, ui32Length);
    } else {
        i2c->CR1 |= I2C_CR1_STOP_Msk;
    }

    return err;
}

uint32_t i2c_io_write_read_sync(i2c_io_t *me, uint16_t ui16DevAddr,
                                const uint8_t *pui8TxBuff, uint32_t ui32TxLength,
                                uint8_t *pui8RxBuff, uint32_t ui32RxLength)
{
    if ((me == NULL) || (pui8TxBuff == NULL) || (ui32TxLength == 0U) ||
        (pui8RxBuff == NULL) || (ui32RxLength == 0U)) {
        return ERROR_INVALID_PARAM;
    }

    I2C_TypeDef *i2c = i2c_get_instance(me->ui32I2cPort);

    if (i2c == NULL) {
        return ERROR_INVALID_PARAM;
    }

    /* Caller must hold the bus lock (i2c_io_lock()) - see i2c_io.h. */

    uint32_t err = i2c_start(i2c, ui16DevAddr, false);

    if (err == ERROR_OK) {
        err = i2c_write_bytes(i2c, pui8TxBuff, ui32TxLength);
    }

    if (err == ERROR_OK) {
        /* Repeated START straight into the read phase - no STOP in
         * between, so the slave keeps its internal state (e.g. the
         * 24C256's current address pointer) for the read that follows. */
        err = i2c_start(i2c, ui16DevAddr, true);

        if (err == ERROR_OK) {
            err = i2c_read_bytes(i2c, pui8RxBuff, ui32RxLength);
        } else {
            i2c->CR1 |= I2C_CR1_STOP_Msk;
        }
    } else {
        i2c->CR1 |= I2C_CR1_STOP_Msk;
    }

    return err;
}
